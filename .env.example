# Environment variables — copy to .env and fill in your values
# NEVER commit the .env file

# Anthropic API key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server
PORT=3001
NODE_ENV=development

# Optional: restrict which domains can use the widget
# ALLOWED_ORIGINS=https://example-restaurant.com,https://another-restaurant.com
